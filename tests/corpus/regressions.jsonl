{"id": "rg-001", "input": "55 Park Ave S, New York NY 10016", "expect": {"street_number": "55", "street_name": "PARK", "street_suffix": "AVE", "street_dir_suffix": "S", "city": "NEW YORK", "state": "NY", "zip5": "10016"}, "warnings": [], "note": "a directional letter after the suffix is the postdirectional (Pub 28 233.22), not a bare unit"}
{"id": "rg-002", "input": "123 Main St Unit #4", "expect": {"street_number": "123", "street_name": "MAIN", "street_suffix": "ST", "unit_type": "UNIT", "unit_number": "4"}, "warnings": ["missing_city", "missing_state", "missing_zip"], "note": "designator, #, number is one unit"}
{"id": "rg-003", "input": "PO Box 123 Apt 4", "expect": {"po_box": "123", "unit_type": "APT", "unit_number": "4"}, "warnings": ["missing_city", "missing_state", "missing_zip"], "note": "a unit right after the box number"}
{"id": "rg-004", "input": "123 ROUTE 9 APT 2", "expect": {"street_number": "123", "highway": {"prefix": "ROUTE", "route": "9"}, "unit_type": "APT", "unit_number": "2"}, "warnings": ["missing_city", "missing_state", "missing_zip"], "note": "a unit right after a highway route"}
{"id": "rg-005", "input": "123 Main St, Miami", "expect": {"street_number": "123", "street_name": "MAIN", "street_suffix": "ST", "city": "MIAMI"}, "warnings": ["missing_state", "missing_zip"], "note": "a later line is not merged into the street name; plain words after a street are the city"}
{"id": "rg-006", "input": "123 Main St Miami FL", "expect": {"street_number": "123", "street_name": "MAIN", "street_suffix": "ST", "city": "MIAMI", "state": "FL"}, "warnings": ["missing_zip"], "note": "state with no ZIP or commas, after a city"}
{"id": "rg-007", "input": "500 Ocean Dr Ste 5 FL", "expect": {"street_number": "500", "street_name": "OCEAN", "street_suffix": "DR", "unit_type": "STE", "unit_number": "5", "second_unit_type": "FL"}, "warnings": ["missing_city", "missing_state", "missing_zip", "missing_unit_number"], "note": "FL with no ZIP and no city before it is not taken as a state"}
{"id": "rg-008", "input": "GENERAL DELIVERY JUNEAU AK 99801", "expect": {"general_delivery": true, "city": "JUNEAU", "state": "AK", "zip5": "99801"}, "warnings": [], "note": "the city follows a special line, with no comma"}
{"id": "rg-009", "input": "12 Lake Shore Dr Chicago Il 60611", "expect": {"street_number": "12", "street_name": "LAKE SHORE", "street_suffix": "DR", "city": "CHICAGO", "state": "IL", "zip5": "60611"}, "warnings": [], "note": "suffix words inside the name: the street ends at the suffix followed by a non-suffix word"}
{"id": "rg-010", "input": "PSC 1650 BOX 10 APO AE 09001", "expect": {"military": {"kind": "PSC", "number": "1650", "box": "10"}, "military_post_office": "APO", "state": "AE", "zip5": "09001"}, "warnings": [], "note": "military address on one line, no commas"}
{"id": "rg-011", "input": "123 Main St., Ste. 5, Boca Raton, Fla. 33431", "expect": {"street_number": "123", "street_name": "MAIN", "street_suffix": "ST", "unit_type": "STE", "unit_number": "5", "city": "BOCA RATON", "state": "FL", "zip5": "33431"}, "warnings": [], "note": "traditional state abbreviation right before a ZIP"}
{"id": "rg-012", "fields": {"line1": "1 Main St", "line2": "Ste 200", "city": "Boca Raton, FL", "zip": "33431"}, "expect": {"street_number": "1", "street_name": "MAIN", "street_suffix": "ST", "unit_type": "STE", "unit_number": "200", "city": "BOCA RATON", "state": "FL", "zip5": "33431"}, "warnings": [], "note": "state carried in the city field (docs/prior-art.md, dbpr_fl)"}
{"id": "rg-013", "fields": {"line1": "7702 LILLIAN HWY 32506", "city": "PENSACOLA", "state": "FL"}, "expect": {"street_number": "7702", "street_name": "LILLIAN", "street_suffix": "HWY", "city": "PENSACOLA", "state": "FL", "zip5": "32506"}, "warnings": [], "note": "ZIP at the end of line 1 when the ZIP field is empty (Escambia)"}
